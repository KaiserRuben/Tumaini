{
  "name": "tumaini",
  "version": "0.1.2",
  "private": true,
  "scripts": {
    "dev": "vite",
    "type-check": "vue-tsc --noEmit && vue-tsc -p tsconfig.tests.json --noEmit",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.vue",
    "screenshots": "npx playwright test --reporter=list",
    "screenshots:open": "npx playwright show-report tests/screenshots/report"
  },
  "dependencies": {
    "axios": "^1.13.3",
    "vue": "^3.2.31",
    "vue-router": "^4.0.14",
    "vue3-markdown-it": "^1.0.10"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@typescript-eslint/eslint-plugin": "^5.14.0",
    "@typescript-eslint/parser": "^5.14.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/eslint-config-typescript": "^11.0.0",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.32.0",
    "sass": "^1.49.9",
    "typescript": "^5.7.3",
    "vite": "^6.0.0",
    "vue-tsc": "^3.2.8"
  },
  "engines": {
    "node": ">=18"
  }
}
